# Copy to .env (gitignored) for local runs.
#
# The server reads configuration from the process environment, not from a .env
# file directly, so export these before running — e.g.:
#   set -a; . ./.env; set +a
#   cargo run

# --- Database -----------------------------------------------------------------
# Local (docker compose / `supabase start`):
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
# Supabase (Session pooler on port 5432 — NOT the 6543 transaction pooler,
# which breaks sqlx's prepared statements):
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Secrets (generate with `cargo run -- keygen`, 64 hex chars each) ----------
TOTP_SECURITY__SECRET_ENCRYPTION_KEY=
TOTP_SECURITY__PASETO_KEY=

# --- Tests (tests/api.rs). Unset → DB-backed tests skip instead of failing. ----
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
